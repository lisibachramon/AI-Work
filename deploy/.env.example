# Production .env — lives at /home/serverlisibachnet/docker/kitchen/.env on the server.
# NEVER commit a real one. Copy this file to .env and fill in.

# --- Public vhost & TLS ---
# nginx-proxy + letsencrypt-companion (your existing stack) will route this
# vhost to the kitchen-web container and issue a Let's Encrypt cert.
KITCHEN_VHOST=kitchen.lisibach.xyz
LETSENCRYPT_EMAIL=you@example.com

# --- Images (the CI pipeline pushes :latest on every successful main build) ---
KITCHEN_API_IMAGE=ghcr.io/lisibachramon/ai-work/kitchen-api:latest
KITCHEN_WEB_IMAGE=ghcr.io/lisibachramon/ai-work/kitchen-web:latest

# --- Postgres ---
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=__set_me__
POSTGRES_DB=kitchen

# --- API ---
# openssl rand -hex 32
SESSION_SECRET=__set_me__
# If set, /auth/register requires this code in the body. Leave empty to disable
# registration entirely (set up the first account before turning it off).
INVITE_CODE=__set_me_or_leave_empty__

# --- Ollama (uses the existing container on proxy_default network) ---
# Container name is "ollama" in your main stack. Internal port is 11434 (default).
OLLAMA_BASE_URL=http://ollama:11434
# Fits an RTX 2060 (6 GB VRAM) at Q4_K_M (~4.7 GB resident).
OLLAMA_TEXT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=bge-m3
# Only used if you flip vision to ollama; default routing keeps vision on Claude.
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# --- Anthropic auth ---
# Pick ONE of the two below:
#
# Option A (recommended) — long-lived OAuth token tied to your Claude.ai
# subscription. Generate on any machine with Claude Code installed:
#     claude setup-token
# Paste the resulting `sk-ant-oat01-...` string here. Subscription billing,
# no separate API credits.
CLAUDE_OAUTH_TOKEN=
#
# Option B — standard Anthropic API key (`sk-ant-api03-...`), billed per
# token from your console.anthropic.com account.
ANTHROPIC_API_KEY=
#
# Beta header sent with OAuth-authenticated calls. Only change if Anthropic
# announces a newer version.
ANTHROPIC_OAUTH_BETA=oauth-2025-04-20

ANTHROPIC_VISION_MODEL=claude-sonnet-4-6
ANTHROPIC_RECIPE_MODEL=claude-sonnet-4-6
ANTHROPIC_PLAN_MODEL=claude-opus-4-7
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5

# --- Per-task provider routing: "ollama" | "anthropic" ---
TASK_TRANSCRIPT_PARSE_PROVIDER=ollama
TASK_BARCODE_GUESS_PROVIDER=ollama
TASK_AUTOCOMPLETE_PROVIDER=ollama
TASK_EMBEDDINGS_PROVIDER=ollama
TASK_PHOTO_VISION_PROVIDER=anthropic
TASK_VIDEO_VISION_PROVIDER=anthropic
TASK_RECIPE_GENERATION_PROVIDER=anthropic
TASK_MEAL_PLAN_PROVIDER=anthropic

# --- Whisper (off by default; enable with `--profile whisper`) ---
WHISPER_BASE_URL=http://whisper:9000
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=de

# --- Video scanner ---
VIDEO_MAX_VISION_CALLS_PER_SESSION=30
