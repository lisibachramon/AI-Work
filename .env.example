# --- Postgres ---
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=kitchen
DATABASE_URL=postgres://kitchen:change-me-strong@postgres:5432/kitchen

# --- API ---
API_PORT=8080
SESSION_SECRET=change-me-64-bytes-hex
PUBLIC_BASE_URL=https://kitchen.local:8443

# --- LLM router ---
# For local dev with Ollama running on the host directly:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
# For prod (the deploy/ stack) where Ollama is a container on proxy_default:
#   OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Default sized for an RTX 2060 (6 GB). Bump to qwen2.5:14b-instruct on larger GPUs.
OLLAMA_TEXT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# --- Auth (public web exposure) ---
ALLOWED_ORIGIN=https://kitchen.local:8443
INVITE_CODE=

# Anthropic — used for vision + recipe generation by default.
# Pick ONE: a long-lived OAuth token from `claude setup-token` (billed to
# your Claude.ai subscription) OR a standard API key from console.anthropic.com.
CLAUDE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_OAUTH_BETA=oauth-2025-04-20
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6
ANTHROPIC_RECIPE_MODEL=claude-sonnet-4-6
ANTHROPIC_PLAN_MODEL=claude-opus-4-7
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5

# Per-task provider routing: "ollama" | "anthropic"
TASK_TRANSCRIPT_PARSE_PROVIDER=ollama
TASK_BARCODE_GUESS_PROVIDER=ollama
TASK_AUTOCOMPLETE_PROVIDER=ollama
TASK_EMBEDDINGS_PROVIDER=ollama
TASK_PHOTO_VISION_PROVIDER=anthropic
TASK_VIDEO_VISION_PROVIDER=anthropic
TASK_RECIPE_GENERATION_PROVIDER=anthropic
TASK_MEAL_PLAN_PROVIDER=anthropic

# --- Whisper sidecar ---
WHISPER_BASE_URL=http://whisper:9000
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=de

# --- Video scanner cost cap ---
VIDEO_MAX_VISION_CALLS_PER_SESSION=30
