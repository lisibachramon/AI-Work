{
  "name": "ai-work",
  "private": true,
  "version": "0.0.0",
  "description": "Self-hosted kitchen inventory + AI recipe planner",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @kitchen/db generate",
    "db:migrate": "pnpm --filter @kitchen/db migrate",
    "db:seed": "pnpm --filter @kitchen/db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2"
  }
}
