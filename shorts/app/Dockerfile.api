# syntax=docker/dockerfile:1.7
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy

# ffmpeg for compositing, espeak-ng for the XTTS phonemizer, fonts for caption
# burn-in (DejaVu covers Latin + Devanagari well enough for our locales).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      espeak-ng \
      fonts-dejavu-core \
      fonts-noto-cjk \
      ca-certificates \
      curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://astral.sh/uv/install.sh | sh && mv /root/.local/bin/uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml alembic.ini ./
COPY src ./src

# Install with the tts extra so XTTS is present. This is a fat image (~4 GB)
# because of torch + TTS weights pulled on first use.
RUN uv pip install --system --no-cache ".[tts]"

ENV SHORTS_DATA_DIR=/data \
    SHORTS_TTS_MODELS_DIR=/models \
    SHORTS_CACHE_DIR=/cache \
    SHORTS_ASSETS_DIR=/assets
VOLUME ["/data", "/models", "/cache", "/assets"]

EXPOSE 8080

# Run migrations before starting the API. Re-runnable; alembic skips revisions
# already applied. If migrations fail (e.g. unreachable DB on a cold cluster),
# the container exits and docker restarts it — eventual consistency works fine
# given the depends_on healthcheck in compose.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn shorts.main:app --host 0.0.0.0 --port 8080"]
