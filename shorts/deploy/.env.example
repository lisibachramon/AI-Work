# Production .env — lives at /home/serverlisibachnet/docker/shorts/.env on the server.
# NEVER commit a real one. Copy this file to .env and fill in.

# --- Public vhost & TLS ---
# nginx-proxy + letsencrypt-companion (your existing stack) will route this
# vhost to the shorts api container and issue a Let's Encrypt cert.
SHORTS_VHOST=shorts.lisibach.xyz
LETSENCRYPT_EMAIL=you@example.com

# --- Image (CI pushes :latest on every successful main build) ---
SHORTS_API_IMAGE=ghcr.io/lisibachramon/ai-work/shorts-api:latest

# --- Postgres ---
POSTGRES_USER=shorts
POSTGRES_PASSWORD=__set_me__
POSTGRES_DB=shorts

# --- Discovery / scheduling ---
LOCALES=de,en-US,es,in
RUNS_PER_DAY=4
MAX_UPLOADS_PER_DAY=6

# --- YouTube Data API v3 (read-only, for discovery) ---
# Create at https://console.cloud.google.com/apis/credentials — restrict to
# YouTube Data API v3.
YOUTUBE_API_KEY=__set_me__

# --- Apify (TikTok trending; optional, leave empty to skip TikTok) ---
APIFY_TOKEN=

# --- Pexels (free stock B-roll) ---
PEXELS_API_KEY=

# --- Plex (optional, B-roll variety) ---
# If set, also mount the Plex media library read-only in docker-compose.yml.
PLEX_BASE_URL=
PLEX_TOKEN=

# --- Anthropic auth (one of) ---
# Option A (recommended): long-lived OAuth token from `claude setup-token`.
CLAUDE_OAUTH_TOKEN=
# Option B: standard API key.
ANTHROPIC_API_KEY=
ANTHROPIC_OAUTH_BETA=oauth-2025-04-20
ANTHROPIC_SCRIPT_MODEL=claude-sonnet-4-6

# --- ElevenLabs (optional override for XTTS; falls back to XTTS if empty) ---
ELEVENLABS_API_KEY=

# --- Whisper sidecar (reuses kitchen's; see kitchen .env for WHISPER_MODEL) ---
WHISPER_BASE_URL=http://whisper:9000

# --- YouTube uploader (OAuth — see docs/runbook.md for the one-time setup) ---
YT_CLIENT_ID=__set_me__
YT_CLIENT_SECRET=__set_me__
YT_REFRESH_TOKEN=__set_me__
YT_UPLOAD_PRIVACY=private
YT_CATEGORY_ID=24

# --- Fair-use posture (do not raise without legal review) ---
MAX_SOURCE_CLIP_SECONDS=8
TARGET_DURATION_SECONDS=40
