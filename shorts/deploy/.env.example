# Production .env — lives at /home/serverlisibachnet/docker/shorts/.env on the server.
# NEVER commit a real one. Copy this file to .env and fill in.

# --- Public vhost & TLS ---
# nginx-proxy + letsencrypt-companion (your existing stack) will route this
# vhost to the shorts api container and issue a Let's Encrypt cert.
SHORTS_VHOST=shorts.lisibach.xyz
LETSENCRYPT_EMAIL=you@example.com

# --- Image (CI pushes :latest on every successful main build) ---
SHORTS_API_IMAGE=ghcr.io/lisibachramon/ai-work/shorts-api:latest

# --- Postgres ---
POSTGRES_USER=shorts
POSTGRES_PASSWORD=__set_me__
POSTGRES_DB=shorts

# --- Discovery / scheduling ---
LOCALES=de,en-US,es,in
RUNS_PER_DAY=4
MAX_UPLOADS_PER_DAY=6

# --- YouTube Data API v3 (read-only, for discovery) ---
# Create at https://console.cloud.google.com/apis/credentials — restrict to
# YouTube Data API v3.
YOUTUBE_API_KEY=__set_me__

# --- Apify (TikTok trending; optional, leave empty to skip TikTok) ---
APIFY_TOKEN=

# --- Pexels (free stock B-roll) ---
PEXELS_API_KEY=

# --- Plex (optional, B-roll variety) ---
# If set, also mount the Plex media library read-only in docker-compose.yml.
PLEX_BASE_URL=
PLEX_TOKEN=

# --- Anthropic auth (one of) ---
# Option A (recommended): long-lived OAuth token from `claude setup-token`.
CLAUDE_OAUTH_TOKEN=
# Option B: standard API key.
ANTHROPIC_API_KEY=
ANTHROPIC_OAUTH_BETA=oauth-2025-04-20
ANTHROPIC_SCRIPT_MODEL=claude-sonnet-4-6

# --- ElevenLabs (optional override for XTTS; falls back to XTTS if empty) ---
ELEVENLABS_API_KEY=

# --- Whisper sidecar (reuses kitchen's; see kitchen .env for WHISPER_MODEL) ---
WHISPER_BASE_URL=http://whisper:9000

# --- YouTube uploader (OAuth — see docs/runbook.md for the one-time setup) ---
YT_CLIENT_ID=__set_me__
YT_CLIENT_SECRET=__set_me__
YT_REFRESH_TOKEN=__set_me__
YT_UPLOAD_PRIVACY=private
YT_CATEGORY_ID=24

# --- Multi-channel routing (optional; niche channels monetise better) ---
# JSON dict mapping locale -> per-channel OAuth. Locales not in the dict fall
# back to the global YT_* above. Example:
#   {"de":{"client_id":"...","client_secret":"...","refresh_token":"..."},"en-US":{...}}
YT_CHANNELS_JSON=

# --- Branding / thumbnail ---
CHANNEL_NAME=
UPLOAD_CUSTOM_THUMBNAIL=true

# --- Variants (A/B levers for CTR + retention) ---
TITLE_VARIANTS=3
HOOK_VARIANTS=3

# --- Multi-aspect renders (cross-platform bundle) ---
# Render every short in these aspects: 9x16 for Shorts/Reels/TikTok,
# 1x1 for IG feed, 16x9 for X / YouTube long-form companion.
RENDER_ASPECTS=9x16,1x1,16x9

# --- Rising-trend discovery (first-mover advantage) ---
# Pulls Reddit /r/<country>/rising + Google Trends daily RSS, resolves topics
# to recent YouTube videos, and feeds them into the same ranker.
RISING_TRENDS_ENABLED=true
RISING_TOPICS_PER_LOCALE=8
RISING_WINDOW_HOURS=24

# --- Long-form companion (10–50× per-video revenue when a Short pops) ---
# When a Short crosses LONGFORM_TRIGGER_VIEWS within LONGFORM_TRIGGER_DAYS
# the daily dispatcher (04:45 UTC) auto-spawns a 5–10 min essay on the same
# topic. Off by default — flip to true once you have analytics flowing.
LONGFORM_ENABLED=false
LONGFORM_TRIGGER_VIEWS=25000
LONGFORM_TRIGGER_DAYS=3
LONGFORM_UPLOAD_PRIVACY=private
# 24=Entertainment, 25=News & Politics, 27=Education, 28=Science & Tech.
LONGFORM_CATEGORY_ID=24
MAX_LONGFORM_PER_DAY=2

# --- Analytics feedback loop ---
# Set true once you've re-minted the OAuth refresh token with the
# yt-analytics scopes (see docs/runbook.md "Re-mint for analytics").
YT_ANALYTICS_ENABLED=false
YT_WINNER_LOOKBACK_DAYS=30
YT_WINNER_MIN_VIEWS=5000

# --- Pinned CTA comment (list-building / cross-promotion) ---
# {video_url} is replaced with the just-uploaded video URL at post time.
POST_PINNED_COMMENT=false
CTA_COMMENT_TEMPLATE=

# --- Affiliate link injection (passive revenue layer) ---
# Drop a YAML file into the shorts-assets volume; see deploy/affiliates.example.yml.
AFFILIATES_YAML_PATH=/assets/affiliates.yml
# Used to build /go/<slug> short URLs. Should be the same as SHORTS_VHOST.
LINK_REDIRECT_DOMAIN=https://shorts.lisibach.xyz
# Amazon Associates tag (https://affiliate-program.amazon.com).
AMAZON_TAG=

# --- Voice cloning (consistent host voice → channel identity) ---
# Path inside the container to a 6–10s clean .wav sample. Leave empty for
# the built-in XTTS speaker.
HOST_VOICE_SAMPLE_PATH=/assets/host_voice.wav

# --- Fair-use posture (do not raise without legal review) ---
MAX_SOURCE_CLIP_SECONDS=8
TARGET_DURATION_SECONDS=40
